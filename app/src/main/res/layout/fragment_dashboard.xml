<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/text_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conversor de Unidades"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"/>

            <!-- IDENTIFICAÇÃO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Identificação">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIdentificacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- VALOR -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Valor">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etValorMedida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ORIGEM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="De:"
                android:layout_marginTop="16dp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerOrigem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- DESTINO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Para:"
                android:layout_marginTop="12dp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinnerDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- RESULTADO -->
            <TextView
                android:id="@+id/tvResultadoConversao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#6200EE"
                android:gravity="center"
                android:layout_marginTop="20dp"/>

            <!-- BOTÃO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/salvarItemButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Salvar Conversão"
                android:layout_marginTop="20dp"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </ScrollView>

</com.google.android.material.card.MaterialCardView>