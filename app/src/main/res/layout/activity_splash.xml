<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a14">

    <ImageView
        android:id="@+id/splash_triangle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_spectra"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splash_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/splash_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPECTRA"
        android:textColor="#ffffff"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/splash_triangle"
        app:layout_constraintBottom_toTopOf="@id/splash_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="visão inteligente"
        android:textColor="#22c55e"
        android:textSize="14sp"
        android:letterSpacing="0.2"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/splash_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>